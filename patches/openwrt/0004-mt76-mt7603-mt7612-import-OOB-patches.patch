diff --git a/package/kernel/mt76/patches/0009-wifi-mt76-mt7603-perform-reset-on-queue-timeout.patch b/package/kernel/mt76/patches/0009-wifi-mt76-mt7603-perform-reset-on-queue-timeout.patch
