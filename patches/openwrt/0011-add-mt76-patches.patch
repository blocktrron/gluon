index 0000000000000000000000000000000000000000..ad94f19bfe9d89836c1ce816cfd635d37c116af2
--- /dev/null
+++ b/package/kernel/mt76/patches/0008-wifi-mt76-mt7603-avoid-sending-MCU-messages-on-pendi.patch
@@ -0,0 +1,31 @@
+From 09f1fcc06d1b54a571c123862e8a0dca57f0ae29 Mon Sep 17 00:00:00 2001
+From: David Bauer <mail@david-bauer.net>
+Date: Mon, 7 Sep 2026 23:17:49 +0200
+Subject: [PATCH 8/9] wifi: mt76: mt7603: avoid sending MCU messages on pending
+ reset
+
+Abort sending messages to the MCU in case a MCU related reset is
+pending.
+
+Signed-off-by: David Bauer <mail@david-bauer.net>
+---
+ mt7603/mcu.c | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/mt7603/mcu.c b/mt7603/mcu.c
+index e432cce9..65c4d93e 100644
+--- a/mt7603/mcu.c
++++ b/mt7603/mcu.c
+@@ -43,6 +43,9 @@ mt7603_mcu_skb_send_msg(struct mt76_dev *mdev, struct sk_buff *skb,
+ 	struct mt7603_mcu_txd *txd;
+ 	u8 seq;
+ 
++	if (dev->mcu_hang)
++		return -EIO;
++
+ 	mdev->mcu.timeout = 3 * HZ;
+ 
+ 	seq = ++mdev->mcu.msg_seq & 0xf;
+-- 
+2.53.0
+
