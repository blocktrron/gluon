++++ b/mt7915/mac.c
+@@ -2160,7 +2160,7 @@ void mt7915_mac_work(struct work_struct *work)
+ 
+ 	mt76_tx_status_check(mphy->dev, false);
+ 
+-	if (!time_is_after_jiffies(phy->last_txwi_loss_check + HZ)) {
++	if (0 && !time_is_after_jiffies(phy->last_txwi_loss_check + HZ)) {
+ 		mt7915_txwi_loss_work(mphy);
+ 		phy->last_txwi_loss_check = jiffies;
+ 	}
