diff --git a/package/kernel/mt76/patches/0004-debugfs-store-head-fid.patch b/package/kernel/mt76/patches/0004-debugfs-store-head-fid.patch
new file mode 100644
index 0000000000000000000000000000000000000000..50fc163171ea5047316d4fa3907e7bf813a8e879
--- /dev/null
+++ b/package/kernel/mt76/patches/0004-debugfs-store-head-fid.patch
@@ -0,0 +1,40 @@
+From de57e84392c6031e30becbeb5f6cf7cd49103437 Mon Sep 17 00:00:00 2001
+From: David Bauer <mail@david-bauer.net>
+Date: Thu, 13 Nov 2025 17:10:22 +0100
+Subject: [PATCH 4/5] debugfs: store head fid
+
+---
+ mt7915/debugfs.c | 9 +++++++--
+ 1 file changed, 7 insertions(+), 2 deletions(-)
+
+diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
+index b287b7d9..44b8d28d 100644
+--- a/mt7915/debugfs.c
++++ b/mt7915/debugfs.c
+@@ -853,6 +853,8 @@ mt7915_sta_hw_queue_read(void *data, struct ieee80211_sta *sta)
+ 		u32 qlen, ctrl, val;
+ 		u32 idx = msta->wcid.idx >> 5;
+ 		u8 offs = msta->wcid.idx & GENMASK(4, 0);
++		u32 q_ctrl2;
++		int head_frame_id, tail_frame_id;
+ 
+ 		ctrl = BIT(31) | BIT(11) | (ac << 24);
+ 		val = mt76_rr(dev, MT_PLE_AC_QEMPTY(ac, idx));
+@@ -863,9 +865,12 @@ mt7915_sta_hw_queue_read(void *data, struct ieee80211_sta *sta)
+ 		mt76_wr(dev, MT_FL_Q0_CTRL, ctrl | msta->wcid.idx);
+ 		qlen = mt76_get_field(dev, MT_FL_Q3_CTRL,
+ 				      GENMASK(11, 0));
+-		seq_printf(s, "\tSTA %pM wcid %d: AC%d%d queued:%d\n",
++		q_ctrl2 = mt76_rr(dev, MT_FL_Q2_CTRL);
++		head_frame_id = FIELD_GET(MT_FL_Q2_CTRL_HFID, q_ctrl2);
++		tail_frame_id = FIELD_GET(MT_FL_Q2_CTRL_TFID, q_ctrl2);
++		seq_printf(s, "\tSTA %pM wcid %d: AC%d%d queued:%d Head:%d Tail:%d\n",
+ 			   sta->addr, msta->wcid.idx,
+-			   msta->vif->mt76.wmm_idx, ac, qlen);
++			   msta->vif->mt76.wmm_idx, ac, qlen, head_frame_id, tail_frame_id);
+ 	}
+ }
+ 
+-- 
+2.51.0
+
