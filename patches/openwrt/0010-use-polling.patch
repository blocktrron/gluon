++
++		/* ToDo: Check if this can be set with initial check */
++		if (head_frame_id == 0xFFF) {
++			/* Queue empty */
++			dev_warn(mdev->dev,
++					 "STA %pM AC %d hw queue empty detected\n",
++					 sta->addr, ac);
++			hwq->head = 0xFFF;
++			hwq->last_update = jiffies;
+ 			continue;
+-		
+-		if (wcid->last_txwi_loss_jiffies && time_is_after_jiffies(wcid->last_txwi_loss_jiffies + 10 * HZ))
++		}
++
++		if (hwq->head != head_frame_id) {
++			/* Queue moved, update */
++			hwq->last_update = jiffies;
++			hwq->head = head_frame_id;
+ 			continue;
+-		
+-		dev_warn(mdev->dev, "txwi timeout token %d pktid %d wcid-skb %d\n", id, cb->pktid, cb->wcid);
+-		sta = wcid_to_sta(wcid);
+-		if (sta) {
+-			mt7915_ple_purge(sta);
+-			// ieee80211_report_low_ack(sta, 10);
+ 		}
+-		wcid->last_txwi_loss_jiffies = jiffies;
+ 
+-		rcu_read_unlock();
++		if (time_is_after_jiffies(hwq->last_update + HZ * 5))
++			continue;
++
++		/* Queue stuck, purge */
++		mt7915_sta_purge_hw_queue(sta, ac);
+ 	}
+-	spin_unlock_bh(&mdev->token_lock);
++}
