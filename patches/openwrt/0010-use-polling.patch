+-		rcu_read_lock();
+-		if (!txwi->jiffies)
+-			continue;
+-		
+-		if (!txwi->skb)
+-			continue;
+-		
+-		if (time_is_after_jiffies(txwi->jiffies + 1 * HZ))
+-			continue;
+-		
+-		struct mt76_tx_cb *cb = mt76_tx_skb_cb(txwi->skb);
+-		if (cb->pktid < MT_PACKET_ID_FIRST)
++	/* ToDo: Lock Q-CTRL */
++
++	for (ac = 0; ac < 4; ac++) {
++		hwq = &msta->hwq_state[ac];
++
++		/* Check if STA has frames pending. */
++		q_empty = mt76_rr(dev, MT_PLE_AC_QEMPTY(ac, msta->wcid.idx >> 5));
