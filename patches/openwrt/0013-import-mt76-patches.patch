diff --git a/package/kernel/mt76/patches/0006-wifi-mt76-mt7915-configure-per-sta.patch b/package/kernel/mt76/patches/0006-wifi-mt76-mt7915-configure-per-sta.patch
new file mode 100644
index 0000000000000000000000000000000000000000..6ae9390abdec31fb656a6e731218f4df4b3702a5
--- /dev/null
+++ b/package/kernel/mt76/patches/0006-wifi-mt76-mt7915-configure-per-sta.patch
@@ -0,0 +1,71 @@
+From 084c39a92364c53a4392a00d0c11fed81124f3e0 Mon Sep 17 00:00:00 2001
+From: David Bauer <mail@david-bauer.net>
+Date: Thu, 25 Dec 2025 17:42:51 +0100
+Subject: [PATCH 6/6] wifi: mt76: mt7915: configure per-sta
+
+---
+ mt7915/mac.c    | 26 ++++++++++++++++++++++++++
+ mt7915/mt7915.h |  3 ++-
+ 2 files changed, 28 insertions(+), 1 deletion(-)
+
+diff --git a/mt7915/mac.c b/mt7915/mac.c
+index c409ecb6..8df6b327 100644
+--- a/mt7915/mac.c
++++ b/mt7915/mac.c
+@@ -1996,6 +1996,30 @@ void mt7915_mac_sta_rc_work(struct work_struct *work)
+ 	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+ }
+ 
++static void mt7915_mac_sta_psm_check(void *data, struct ieee80211_sta *sta)
++{
++	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
++	struct mt7915_phy *phy = data;
++	struct mt7915_dev *dev = phy->dev;
++
++	if (msta->psm.initial_set && !!msta->psm.psm_set == !!msta->psm.active_since)
++		return;
++	
++	if (msta->psm.initial_set &&
++	    time_is_after_jiffies(msta->psm.active_since + (1000 * HZ)))
++		return;
++	
++	mt7915_mcu_set_packet_limit(dev, msta->wcid.idx, msta->vif->mt76.idx, msta->psm.active_since ? 1 : 64);
++	msta->psm.initial_set = true;
++	msta->psm.psm_set = !!msta->psm.active_since;
++}
++
++static void mt7915_psm_work(struct mt7915_phy *phy)
++{
++	ieee80211_iterate_stations_atomic(phy->mt76->hw,
++					  mt7915_mac_sta_psm_check, phy);
++}
++
+ void mt7915_mac_work(struct work_struct *work)
+ {
+ 	struct mt7915_phy *phy;
+@@ -2014,6 +2038,8 @@ void mt7915_mac_work(struct work_struct *work)
+ 		mt7915_mac_update_stats(phy);
+ 		mt7915_mac_severe_check(phy);
+ 
++		mt7915_psm_work(phy);
++
+ 		if (phy->dev->muru_debug)
+ 			mt7915_mcu_muru_debug_get(phy);
+ 	}
+diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
+index 21847286..e98a578c 100644
+--- a/mt7915/mt7915.h
++++ b/mt7915/mt7915.h
+@@ -148,7 +148,8 @@ struct mt7915_sta {
+ 	struct mt76_connac_sta_key_conf bip;
+ 
+ 	struct {
+-		u64 active_since;
++		unsigned long active_since;
++		u8 initial_set;
+ 		u8 psm_set;
+ 	} psm;
+ 
+-- 
+2.51.0
+
