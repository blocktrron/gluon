--- /dev/null
+++ b/package/kernel/mt76/patches/0003-wifi-mt76-mt7915-track-entry-times.patch
@@ -0,0 +1,60 @@
+From 5bac5f02f9ab5874b2a984a2ebe46f5ab1dec62d Mon Sep 17 00:00:00 2001
+From: David Bauer <mail@david-bauer.net>
+Date: Wed, 24 Dec 2025 23:13:30 +0100
+Subject: [PATCH 3/6] wifi: mt76: mt7915: track entry times
+
+---
+ mt7915/mmio.c   | 13 +++++++++++++
+ mt7915/mt7915.h |  5 +++++
+ 2 files changed, 18 insertions(+)
+
+diff --git a/mt7915/mmio.c b/mt7915/mmio.c
+index 2708b155..5cd3c96b 100644
+--- a/mt7915/mmio.c
++++ b/mt7915/mmio.c
+@@ -914,6 +914,18 @@ irqreturn_t mt7915_irq_handler(int irq, void *dev_instance)
+ 	return IRQ_HANDLED;
+ }
+ 
++static void
++mt7915_sta_ps(struct mt76_dev *mdev, struct ieee80211_sta *sta, bool ps)
++{
++	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
++
++	if (ps) {
++		msta->psm.active_since = jiffies;
++	} else {
++		msta->psm.active_since = 0;
++	}
++}
++
