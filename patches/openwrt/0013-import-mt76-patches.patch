diff --git a/package/kernel/mt76/patches/0005-wifi-mt76-mt7915-configure-packet-limits.patch b/package/kernel/mt76/patches/0005-wifi-mt76-mt7915-configure-packet-limits.patch
new file mode 100644
index 0000000000000000000000000000000000000000..38dfb8e05051be818e65e612fa9717ee77eef3b7
--- /dev/null
+++ b/package/kernel/mt76/patches/0005-wifi-mt76-mt7915-configure-packet-limits.patch
@@ -0,0 +1,87 @@
+From d9b71c46c82521e23480575948363133baa1c69e Mon Sep 17 00:00:00 2001
+From: David Bauer <mail@david-bauer.net>
+Date: Wed, 24 Dec 2025 23:22:36 +0100
+Subject: [PATCH 5/6] wifi: mt76: mt7915: configure packet limits
+
+---
+ mt76_connac_mcu.h |  1 +
+ mt7915/mcu.c      | 31 ++++++++++++++++++++++++++++++-
+ mt7915/mt7915.h   |  1 +
+ 3 files changed, 32 insertions(+), 1 deletion(-)
+
+diff --git a/mt76_connac_mcu.h b/mt76_connac_mcu.h
+index 8d59cf43..7f773796 100644
+--- a/mt76_connac_mcu.h
++++ b/mt76_connac_mcu.h
+@@ -1247,6 +1247,7 @@ enum {
+ 	MCU_EXT_CMD_TXDPD_CAL = 0x60,
+ 	MCU_EXT_CMD_CAL_CACHE = 0x67,
+ 	MCU_EXT_CMD_RED_ENABLE = 0x68,
++	MCU_EXT_CMD_SET_PKT_LIMIT = 0x6c,
+ 	MCU_EXT_CMD_CP_SUPPORT = 0x75,
+ 	MCU_EXT_CMD_SET_RADAR_TH = 0x7c,
+ 	MCU_EXT_CMD_SET_RDD_PATTERN = 0x7d,
+diff --git a/mt7915/mcu.c b/mt7915/mcu.c
+index 7750d469..15a11ccd 100644
+--- a/mt7915/mcu.c
++++ b/mt7915/mcu.c
+@@ -2361,6 +2361,31 @@ static int mt7915_red_set_watermark(struct mt7915_dev *dev)
+ 				 sizeof(req), false);
+ }
+ 
++int mt7915_mcu_set_packet_limit(struct mt7915_dev *dev, u8 bss_idx, u16 wcid_idx, u32 limit)
++{
++	#define MT7915_PKT_LIMIT_NUM_QUEUES  (2 * 5)
++	#define MT7915_PKT_LIMITS (MT7915_PKT_LIMIT_NUM_QUEUES * 2)
++
++	struct {
++		u8 bss_idx;
++		u8 num_queues;
++		__le16 wcid_idx;
++		uint8_t rsv[4];
++		__le16 limits[MT7915_PKT_LIMITS];
++	} __packed req = {
++		.bss_idx = bss_idx,
++		.num_queues = MT7915_PKT_LIMIT_NUM_QUEUES,
++		.wcid_idx = cpu_to_le16(wcid_idx),
++	};
++
++	for (u8 i = 0; i < MT7915_PKT_LIMITS; i++)
++		req.limits[i] = cpu_to_le16(limit);
++
++	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_EXT_CMD(SET_PKT_LIMIT), &req,
++				 sizeof(req), true);
++}
++
++
+ static int mt7915_mcu_set_red(struct mt7915_dev *dev, bool enabled)
+ {
+ #define RED_DISABLE		0
+@@ -2446,7 +2471,11 @@ int mt7915_mcu_init_firmware(struct mt7915_dev *dev)
+ 	if (ret)
+ 		return ret;
+ 
+-	return mt7915_mcu_set_red(dev, 1);
++	ret = mt7915_mcu_set_red(dev, 1);
++	if (ret)
++		return ret;
++	
++	return mt7915_mcu_set_packet_limit(dev, 0xFF, 0xFFFF, 512);
+ }
+ 
+ int mt7915_mcu_init(struct mt7915_dev *dev)
+diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
+index 80317d58..21847286 100644
+--- a/mt7915/mt7915.h
++++ b/mt7915/mt7915.h
+@@ -531,6 +531,7 @@ int mt7915_mcu_get_chan_mib_info(struct mt7915_phy *phy, bool chan_switch);
+ int mt7915_mcu_get_temperature(struct mt7915_phy *phy);
+ int mt7915_mcu_set_thermal_throttling(struct mt7915_phy *phy, u8 state);
+ int mt7915_mcu_set_thermal_protect(struct mt7915_phy *phy);
++int mt7915_mcu_set_packet_limit(struct mt7915_dev *dev, u8 bss_idx, u16 wcid_idx, u32 limit);
+ int mt7915_mcu_get_rx_rate(struct mt7915_phy *phy, struct ieee80211_vif *vif,
+ 			   struct ieee80211_sta *sta, struct rate_info *rate);
+ int mt7915_mcu_rdd_background_enable(struct mt7915_phy *phy,
+-- 
+2.51.0
